# ============================================================
#  Настройка модели / провайдера — Multi CLI-Agent
#  Этот файл редактируется в любом текстовом редакторе.
#  Лаунчер читает его при каждом запуске.
# ============================================================

# Провайдер: zen | openrouter | github | huggingface
PROVIDER=zen

# Модель (id). Для zen — например deepseek-v4-flash-free
# Для openrouter — например google/gemma-4-31b-it:free
MODEL=deepseek-v4-flash-free

# Vision-модель (для скриншотов/анализа изображений)
VISION_MODEL=google/gemma-4-31b-it:free

# Режим агента: build | plan | explore
AGENT_MODE=build

# Автоодобрение инструментов: 1 / 0
AUTO_APPROVE=0

# ============================================================
#  КЛЮЧИ (опционально). Можно оставить пустым.
# ============================================================

# OpenRouter key (если PROVIDER=openrouter)
OPENROUTER_API_KEY=

# GitHub token (если PROVIDER=github)
GITHUB_TOKEN=

# Hugging Face token (если PROVIDER=huggingface)
HF_TOKEN=
